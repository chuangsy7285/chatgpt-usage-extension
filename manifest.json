{
  "manifest_version": 3,
  "name": "ChatGPT 用量小幫手",
  "version": "0.5.2",
  "description": "側欄用量紀錄，透過登入狀態直接嘗試背景同步，無須保留用量分頁。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT 用量"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "parser.js",
        "sidebar.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "120",
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
